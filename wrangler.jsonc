// Local demo only. Production uses ignored wrangler.production.jsonc.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ordalin-demo",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-23",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "vars": {
    "NEXT_PUBLIC_APP_URL": "http://localhost:3000"
  },
  "assets": {
    "binding": "ASSETS",
    "directory": ".open-next/assets"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ordalin-demo",
      "remote": false,
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "CATALOG_ASSETS",
      "bucket_name": "ordalin-demo-assets",
      "remote": false
    }
  ],
  "browser": {
    "binding": "BROWSER"
  },
  "observability": {
    "enabled": true
  }
}
