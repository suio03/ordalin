{
  "$extensions": {
    "com.ordalin.meta": {
      "name": "Ordalin Quiet Radar",
      "version": "1.1.0",
      "approved": "2026-08-23",
      "themes": ["light", "dark"],
      "defaultTheme": "system",
      "platform": "web"
    }
  },
  "color": {
    "surfacePrimary": { "$type": "color", "$value": "#EDF3F1" },
