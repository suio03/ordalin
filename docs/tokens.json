{
  "$extensions": {
    "com.ordalin.meta": {
      "name": "Ordalin Quiet Radar",
      "version": "1.1.0",
      "approved": "2026-08-23",
      "themes": ["light", "dark"],
      "defaultTheme": "system",
      "platform": "web"
    }
  },
  "color": {
    "surfacePrimary": { "$type": "color", "$value": "#E9EFEC" },
    "surfaceRaised": { "$type": "color", "$value": "#FFFFFF" },
    "surfaceMuted": { "$type": "color", "$value": "#EEF3F1" },
    "surfaceAccent": { "$type": "color", "$value": "#DCE7E3" },
    "surfaceInput": { "$type": "color", "$value": "#FFFFFF" },
    "surfaceLogo": { "$type": "color", "$value": "#FFFFFF" },
    "textPrimary": { "$type": "color", "$value": "#14201D" },
    "textSecondary": { "$type": "color", "$value": "#56645F" },
    "textTertiary": { "$type": "color", "$value": "#5D6A65" },
    "textOnStrong": { "$type": "color", "$value": "#FFFFFF" },
    "borderSubtle": { "$type": "color", "$value": "#14201D24" },
    "borderStrong": { "$type": "color", "$value": "#14201D47" },
    "accentPrimary": { "$type": "color", "$value": "#147754" },
    "accentSoft": { "$type": "color", "$value": "#D9EEE6" },
    "accentText": { "$type": "color", "$value": "#2F5549" },
    "focusRing": { "$type": "color", "$value": "#1F60D3" },
    "danger": { "$type": "color", "$value": "#A63F32" },
    "logoCharcoal": { "$type": "color", "$value": "#111111" },
    "white": { "$type": "color", "$value": "#FFFFFF" }
  },
  "colorDark": {
    "surfacePrimary": { "$type": "color", "$value": "#1C2522" },
    "surfaceRaised": { "$type": "color", "$value": "#29342F" },
    "surfaceMuted": { "$type": "color", "$value": "#35413C" },
    "surfaceAccent": { "$type": "color", "$value": "#3C4A45" },
    "surfaceInput": { "$type": "color", "$value": "#232D29" },
    "surfaceLogo": { "$type": "color", "$value": "#E6ECE9" },
    "textPrimary": { "$type": "color", "$value": "#EEF5F2" },
    "textSecondary": { "$type": "color", "$value": "#B3C0BB" },
    "textTertiary": { "$type": "color", "$value": "#9EACA7" },
    "textOnStrong": { "$type": "color", "$value": "#1C2522" },
    "borderSubtle": { "$type": "color", "$value": "#EAF4F024" },
    "borderStrong": { "$type": "color", "$value": "#EAF4F047" },
    "accentPrimary": { "$type": "color", "$value": "#5BC095" },
    "accentSoft": { "$type": "color", "$value": "#1F4536" },
    "accentText": { "$type": "color", "$value": "#98DDBE" },
    "focusRing": { "$type": "color", "$value": "#78A9FF" },
    "danger": { "$type": "color", "$value": "#EF8D7F" },
    "logoCharcoal": { "$type": "color", "$value": "#FFFFFF" },
    "white": { "$type": "color", "$value": "#FFFFFF" }
  },
  "font": {
    "familyInterface": { "$type": "fontFamily", "$value": ["-apple-system", "BlinkMacSystemFont", "Segoe UI", "sans-serif"] },
    "familyMetadata": { "$type": "fontFamily", "$value": ["ui-monospace", "SFMono-Regular", "Menlo", "monospace"] },
    "weightRegular": { "$type": "fontWeight", "$value": 400 },
    "weightDisplay": { "$type": "fontWeight", "$value": 520 },
    "weightHeading": { "$type": "fontWeight", "$value": 580 },
    "weightStrong": { "$type": "fontWeight", "$value": 650 }
  },
  "fontSize": {
    "metadata": { "$type": "dimension", "$value": "10px" },
    "toolPurpose": { "$type": "dimension", "$value": "11px" },
    "control": { "$type": "dimension", "$value": "11px" },
    "caption": { "$type": "dimension", "$value": "12px" },
    "bodyCompact": { "$type": "dimension", "$value": "13px" },
    "toolName": { "$type": "dimension", "$value": "14px" },
    "body": { "$type": "dimension", "$value": "15px" },
    "panelHeading": { "$type": "dimension", "$value": "15px" },
    "sectionHeading": { "$type": "dimension", "$value": "23px" },
    "displayCompact": { "$type": "dimension", "$value": "39px" },
    "display": { "$type": "dimension", "$value": "61px" }
  },
  "lineHeight": {
    "metadata": { "$type": "number", "$value": 1.4 },
    "tight": { "$type": "number", "$value": 1.0 },
    "control": { "$type": "number", "$value": 1.45 },
    "body": { "$type": "number", "$value": 1.5 }
  },
  "space": {
    "2xs": { "$type": "dimension", "$value": "4px" },
    "xs": { "$type": "dimension", "$value": "8px" },
    "sm": { "$type": "dimension", "$value": "12px" },
    "md": { "$type": "dimension", "$value": "16px" },
    "lg": { "$type": "dimension", "$value": "20px" },
    "xl": { "$type": "dimension", "$value": "24px" },
    "2xl": { "$type": "dimension", "$value": "32px" },
    "3xl": { "$type": "dimension", "$value": "40px" },
    "4xl": { "$type": "dimension", "$value": "48px" },
    "5xl": { "$type": "dimension", "$value": "56px" },
    "6xl": { "$type": "dimension", "$value": "64px" },
    "7xl": { "$type": "dimension", "$value": "80px" }
  },
  "radius": {
    "control": { "$type": "dimension", "$value": "9px" },
    "small": { "$type": "dimension", "$value": "10px" },
    "toolMark": { "$type": "dimension", "$value": "13px" },
    "search": { "$type": "dimension", "$value": "15px" },
    "medium": { "$type": "dimension", "$value": "16px" },
    "panel": { "$type": "dimension", "$value": "20px" },
    "hero": { "$type": "dimension", "$value": "24px" },
    "radarField": { "$type": "dimension", "$value": "28px" },
    "pill": { "$type": "dimension", "$value": "999px" }
  },
  "border": {
    "width": { "$type": "dimension", "$value": "1px" },
    "focusWidth": { "$type": "dimension", "$value": "3px" },
    "focusOffset": { "$type": "dimension", "$value": "3px" }
  },
  "shadow": {
    "soft": { "$type": "shadow", "$value": { "color": "#2A443D17", "offsetX": "0px", "offsetY": "18px", "blur": "54px", "spread": "0px" } },
    "card": { "$type": "shadow", "$value": [{ "color": "#14201D0F", "offsetX": "0px", "offsetY": "1px", "blur": "2px", "spread": "0px" }, { "color": "#2A443D12", "offsetX": "0px", "offsetY": "6px", "blur": "18px", "spread": "0px" }] },
    "darkSoft": { "$type": "shadow", "$value": { "color": "#00000052", "offsetX": "0px", "offsetY": "18px", "blur": "54px", "spread": "0px" } },
    "darkCard": { "$type": "shadow", "$value": [{ "color": "#FFFFFF0A", "offsetX": "0px", "offsetY": "1px", "blur": "0px", "spread": "0px", "inset": true }, { "color": "#00000040", "offsetX": "0px", "offsetY": "1px", "blur": "2px", "spread": "0px" }, { "color": "#00000038", "offsetX": "0px", "offsetY": "8px", "blur": "24px", "spread": "0px" }] }
  },
  "motion": {
    "fast": { "$type": "duration", "$value": "120ms" },
    "standard": { "$type": "duration", "$value": "180ms" },
    "slow": { "$type": "duration", "$value": "260ms" },
    "easeStandard": { "$type": "cubicBezier", "$value": [0.2, 0.7, 0.2, 1] }
  },
  "layout": {
    "contentMax": { "$type": "dimension", "$value": "1312px" },
    "pageGutter": { "$type": "dimension", "$value": "28px" },
    "pageGutterCompact": { "$type": "dimension", "$value": "11px" },
    "categoryRail": { "$type": "dimension", "$value": "205px" },
    "editorialRail": { "$type": "dimension", "$value": "292px" },
    "columnGap": { "$type": "dimension", "$value": "16px" },
    "breakpointWide": { "$type": "dimension", "$value": "1080px" },
    "breakpointMedium": { "$type": "dimension", "$value": "820px" },
    "breakpointSmall": { "$type": "dimension", "$value": "560px" },
    "touchTarget": { "$type": "dimension", "$value": "44px" },
    "pointerTarget": { "$type": "dimension", "$value": "38px" }
  }
}
