{
  "name": "ordalin",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.6.2",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "opennextjs-cloudflare build --config wrangler.production.jsonc && opennextjs-cloudflare preview --config wrangler.production.jsonc --remote",
    "deploy": "opennextjs-cloudflare build --config wrangler.production.jsonc && opennextjs-cloudflare deploy --config wrangler.production.jsonc",
    "build:production": "node scripts/write-production-config.mjs && opennextjs-cloudflare build --config wrangler.production.jsonc",
    "deploy:production": "opennextjs-cloudflare deploy --config wrangler.production.jsonc",
    "cf-typegen": "wrangler types --config wrangler.production.example.jsonc --env-interface CloudflareEnv cloudflare-env.d.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply DB --local --config wrangler.jsonc --persist-to .wrangler/demo",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote --config wrangler.production.jsonc",
    "seed:generate": "node scripts/generate-catalog-seed.mjs",
    "seed:local": "wrangler d1 execute DB --local --file seed/catalog.sql --config wrangler.jsonc --persist-to .wrangler/demo",
    "seed:remote": "wrangler d1 execute DB --remote --file seed/catalog.sql --config wrangler.production.jsonc",
    "enrich:tool": "node --experimental-strip-types --experimental-specifier-resolution=node scripts/enrich-tool.ts",
    "catalog:logos": "node --experimental-strip-types --experimental-specifier-resolution=node scripts/backfill-tool-logos.ts",
    "catalog:screenshots": "node --experimental-strip-types --experimental-specifier-resolution=node scripts/backfill-tool-screenshots.ts",
    "imports:discover": "node --experimental-strip-types --experimental-specifier-resolution=node scripts/discover-catalog-imports.ts",
    "imports:browser-evidence": "node --experimental-strip-types --experimental-specifier-resolution=node scripts/add-browser-evidence.ts",
    "imports:prepare": "node --experimental-strip-types --experimental-specifier-resolution=node scripts/prepare-manual-imports.ts",
    "imports:apply": "node --experimental-strip-types --experimental-specifier-resolution=node scripts/apply-catalog-import.ts",
    "imports:screenshots": "node --experimental-strip-types --experimental-specifier-resolution=node scripts/capture-import-screenshots.ts",
    "test:submissions:runtime": "node scripts/test-submission-runtime.mjs",
    "dev:demo": "ORDALIN_DEMO=1 next dev",
    "demo:setup": "pnpm db:migrate:local && pnpm seed:local",
    "check:public": "node scripts/check-public-repo.mjs"
  },
  "dependencies": {
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@next/mdx": "16.2.11",
    "drizzle-orm": "0.45.2",
    "jose": "^6.2.10",
    "next": "16.2.11",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.19.4",
    "@tailwindcss/postcss": "^4",
    "@types/mdx": "^2.0.14",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.11",
    "sharp": "^0.35.3",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite": "6.4.3",
    "vitest": "^4.1.10",
    "wrangler": "^4.120.0"
  },
  "engines": {
    "node": ">=22 <23",
    "pnpm": ">=10 <11"
  },
  "license": "MIT"
}
